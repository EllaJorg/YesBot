{
  "manifest_version": 3,
  "name": "Yesbot",
  "description": "Detects sycophancy in AI chat responses and displays a score with explanation.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "css": ["styles.css"],
      "js": ["energyConfig.js", "aiClient.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
